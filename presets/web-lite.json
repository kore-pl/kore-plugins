{
  "schema_version": 1,
  "id": "web-lite",
  "name": "轻量 Web",
  "description": "最小动态 Web 能力：site 提供站点与域名管理（唯一常驻）、ssl 提供证书与自动续期、runtime-php 承载 PHP 动态请求；三者均为生产级，开箱可用。",
  "out_of_box": true,
  "plugins": [
    {
      "id": "site",
      "version": "0.4.0",
      "desired": "enabled"
    },
    {
      "id": "ssl",
      "version": "0.5.0",
      "desired": "enabled"
    },
    {
      "id": "runtime-php",
      "version": "0.2.2",
      "desired": "enabled"
    }
  ]
}
